{
  "name": "dsh-harness-update",
  "version": "0.1.0",
  "description": "Self-update for DeepSeek Harness git-source installs: version check, one-click update (pull / install / clean / build), rollback and restart hint. Windows-first: spawns .cmd shims through %ComSpec%.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firefly1376/dsh-harness-update.git"
  },
  "homepage": "https://github.com/firefly1376/dsh-harness-update#readme",
  "bugs": {
    "url": "https://github.com/firefly1376/dsh-harness-update/issues"
  },
  "author": "firefly1376",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "self-update",
    "updater"
  ]
}
